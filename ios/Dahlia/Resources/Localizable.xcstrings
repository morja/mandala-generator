    "menu_chip_previews_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleines Beispiel neben jedem Stil und Motiv. Aus, und die Listen werden kürzer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A small example beside each style and motif. Off, the lists are shorter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pequeño ejemplo junto a cada estilo y motivo. Desactivado, las listas son más cortas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit exemple à côté de chaque style et motif. Désactivé, les listes sont plus courtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un piccolo esempio accanto a ogni stile e motivo. Disattivato, gli elenchi sono più corti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各スタイルとモチーフの横に小さな例を表示します。オフにするとリストが短くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 스타일과 모티프 옆에 작은 예시를 표시합니다. 끄면 목록이 짧아집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pequeno exemplo ao lado de cada estilo e motivo. Desligado, as listas ficam mais curtas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленький пример рядом с каждым стилем и мотивом. Выключено, и списки становятся короче."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在每个样式和图案旁显示小示例。关闭后列表更短。"
