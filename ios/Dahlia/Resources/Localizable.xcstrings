    "about_free_software" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia ist freie Software: Du kannst sie unter den Bedingungen der GNU General Public License, Version 3, wie von der Free Software Foundation veröffentlicht, weitergeben und/oder verändern. Sie wird ohne jede Gewährleistung bereitgestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, version 3. It comes without any warranty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia es software libre: puedes redistribuirlo y/o modificarlo según los términos de la Licencia Pública General de GNU publicada por la Free Software Foundation, versión 3. Se ofrece sin ninguna garantía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia est un logiciel libre : vous pouvez le redistribuer et/ou le modifier selon les termes de la licence publique générale GNU telle que publiée par la Free Software Foundation, version 3. Il est fourni sans aucune garantie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia è software libero: puoi ridistribuirlo e/o modificarlo secondo i termini della GNU General Public License pubblicata dalla Free Software Foundation, versione 3. È fornito senza alcuna garanzia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahliaはフリーソフトウェアです。Free Software Foundationが公表したGNU General Public License第3版の条件に従って、再頒布や改変ができます。保証は一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia는 자유 소프트웨어입니다. 자유 소프트웨어 재단이 발행한 GNU 일반 공중 사용 허가서 버전 3의 조건에 따라 재배포하거나 수정할 수 있습니다. 어떠한 보증도 제공되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia é software livre: você pode redistribuí-lo e/ou modificá-lo sob os termos da GNU General Public License publicada pela Free Software Foundation, versão 3. Ele é fornecido sem qualquer garantia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia — свободное программное обеспечение: вы можете распространять и/или изменять его на условиях GNU General Public License версии 3, опубликованной Free Software Foundation. Программа предоставляется без каких-либо гарантий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahlia 是自由软件：你可以根据自由软件基金会发布的 GNU 通用公共许可证第 3 版的条款重新分发和/或修改它。本软件不提供任何担保。"
          }
        }
      }
    },
