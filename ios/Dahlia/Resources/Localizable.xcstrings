    "editor_pro_adds_making" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro bietet bis zu fünf Ebenen, Embleme, Text und Zitate sowie verschiebbare Ebenen und Embleme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro adds up to five layers, emblems, text and quotes, and moving layers and the emblem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro añade hasta cinco capas, emblemas, texto y citas, y la posibilidad de mover las capas y el emblema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro ajoute jusqu’à cinq calques, des emblèmes, du texte et des citations, ainsi que le déplacement des calques et de l’emblème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro aggiunge fino a cinque livelli, emblemi, testo e citazioni, e la possibilità di spostare i livelli e l’emblema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proでは、最大5つのレイヤー、エンブレム、テキストと引用、レイヤーとエンブレムの移動が使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro에서는 레이어를 최대 다섯 개까지 쓸 수 있고, 엠블럼, 텍스트와 명언, 레이어와 엠블럼 이동이 추가됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pro oferece até cinco camadas, emblemas, texto e citações, além de mover as camadas e o emblema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro добавляет до пяти слоёв, эмблемы, текст и цитаты, а также перемещение слоёв и эмблемы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 提供最多五个图层、徽标、文字和名言，以及移动图层和徽标。"
          }
        }
      }
    },
    "editor_pro_adds_saving" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichern mit 2048 Pixeln Breite, mit von Hand platziertem und angepasstem Mandala, als drehendes Video und als Strichzeichnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save at 2048 pixels wide with the mandala placed by hand and adjusted, as a turning video, and as a line drawing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda a 2048 píxeles de ancho con el mandala colocado a mano y ajustado, como vídeo que gira y como dibujo lineal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez en 2048 pixels de large avec le mandala placé à la main et ajusté, en vidéo qui tourne et en dessin au trait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva a 2048 pixel di larghezza con il mandala posizionato a mano e regolato, come video che ruota e come disegno al tratto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幅2048ピクセルでの保存（マンダラの配置と調整は自由）、回転する動画、線画としての保存も可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너비 2048픽셀로 저장할 수 있으며, 만다라를 직접 배치하고 보정하거나, 회전하는 동영상이나 선화로 저장할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve com 2048 pixels de largura, com a mandala posicionada à mão e ajustada, como vídeo girando e como desenho em linhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранение шириной 2048 пикселей, с размещённой вручную и настроенной мандалой, в виде вращающегося видео и контурного рисунка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可保存为 2048 像素宽的图片，曼陀罗可手动摆放和调整，也可保存为旋转视频和线稿。"
          }
        }
      }
    },
