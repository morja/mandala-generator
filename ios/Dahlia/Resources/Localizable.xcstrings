    "tour_styles_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Ebene hat einen Stil, etwa %1$@ oder %2$@. Öffne diese Zeile und tippe einen an, das Bild ändert sich sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every layer has a style, like %1$@ or %2$@. Open this row and tap one, and the picture changes right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada capa tiene un estilo, como %1$@ o %2$@. Abre esta fila y toca uno; la imagen cambia al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque calque a un style, comme %1$@ ou %2$@. Ouvrez cette ligne et touchez-en un : l'image change aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni livello ha uno stile, come %1$@ o %2$@. Apri questa riga e toccane uno: l'immagine cambia subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各レイヤーには %1$@ や %2$@ などのスタイルがあります。この行を開いてタップすると、すぐに絵が変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 레이어에는 %1$@, %2$@ 같은 스타일이 있습니다. 이 줄을 열고 하나를 누르면 그림이 바로 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada camada tem um estilo, como %1$@ ou %2$@. Abra esta linha e toque em um: a imagem muda na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого слоя есть стиль, например %1$@ или %2$@. Откройте эту строку и выберите стиль — изображение сразу изменится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个图层都有一种风格，例如%1$@或%2$@。打开这一行并点选一个，图片会立刻变化。"
          }
        }
      }
    },
