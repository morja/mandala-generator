    "tour_effects_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter Szene kommen Licht, Körnung, Sterne und mehr dazu. Schalte die Effekte hier ein und halte das Bild gedrückt, um es ohne sie zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scene adds light, grain, stars and more. Switch the effects on here, then hold the picture to see it without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escena añade luz, grano, estrellas y más. Activa los efectos aquí y mantén pulsada la imagen para verla sin ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scène ajoute lumière, grain, étoiles et plus encore. Activez les effets ici, puis maintenez l'image pour la voir sans eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scena aggiunge luce, grana, stelle e altro. Attiva gli effetti qui, poi tieni premuta l'immagine per vederla senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シーンでは光、粒子、星などを加えられます。ここでエフェクトをオンにし、絵を長押しするとエフェクトなしで見られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장면에서 빛, 그레인, 별 등을 더할 수 있습니다. 여기서 효과를 켜고 그림을 길게 누르면 효과 없이 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena adiciona luz, granulado, estrelas e mais. Ative os efeitos aqui e mantenha a imagem pressionada para vê-la sem eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сцена добавляет свет, зерно, звёзды и многое другое. Включите эффекты здесь и удерживайте изображение, чтобы увидеть его без них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "场景可添加光线、颗粒、星星等。在这里开启效果，然后按住图片即可查看没有效果时的样子。"
          }
        }
      }
    },
