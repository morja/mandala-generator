    "menu_daily_pick_about" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die angehakten Favoriten wechseln sich ab, in der Reihenfolge deiner Favoriten. Ein später hinzugefügter Favorit kommt dazu, sobald du ihn hier anhakst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the ticked favourites take turns, in the order of your favourites. A favourite added later joins once you tick it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se alternan los favoritos marcados, en el orden de tus favoritos. Un favorito añadido después entra cuando lo marques aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les favoris cochés se relaient, dans l'ordre de vos favoris. Un favori ajouté plus tard en fait partie une fois coché ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si alternano solo i preferiti spuntati, nell'ordine dei tuoi preferiti. Un preferito aggiunto dopo entra quando lo spunti qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックしたお気に入りだけが、お気に入りの順番で入れ替わります。あとで追加したお気に入りは、ここでチェックすると加わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크한 즐겨찾기만 즐겨찾기 순서대로 번갈아 나옵니다. 나중에 추가한 즐겨찾기는 여기서 체크하면 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só os favoritos marcados se revezam, na ordem dos seus favoritos. Um favorito adicionado depois entra quando você o marcar aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чередуются только отмеченные мандалы из избранного, в его порядке. Добавленная позже войдёт в смену, когда вы отметите её здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有勾选的收藏会按收藏顺序轮换。之后新增的收藏在这里勾选后才会加入。"
          }
        }
      }
    },
