    "tour_favourites_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Stern liegen die Mandalas, die du behalten willst, und ein paar warten schon. Tippe eins an, um es zu öffnen, oder füge das aktuelle hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The star holds the mandalas you keep, and a few are already there. Tap one to open it, or add the one you see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La estrella guarda los mandalas que quieres conservar, y ya hay algunos. Toca uno para abrirlo o añade el que estás viendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'étoile garde les mandalas que vous conservez, et quelques-uns s'y trouvent déjà. Touchez-en un pour l'ouvrir, ou ajoutez celui que vous voyez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La stella custodisce i mandala che tieni, e alcuni ci sono già. Toccane uno per aprirlo o aggiungi quello che vedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星には残しておきたい曼荼羅が入っていて、最初からいくつか用意されています。タップして開くか、表示中のものを追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "별에는 간직하고 싶은 만다라가 모여 있고, 몇 개는 이미 들어 있습니다. 하나를 눌러 열거나 지금 보이는 만다라를 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A estrela guarda as mandalas que você quer manter, e algumas já estão lá. Toque em uma para abrir ou adicione a que está vendo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В звезде хранятся мандалы, которые вы сохранили, и несколько там уже есть. Нажмите на одну, чтобы открыть, или добавьте текущую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星形里存放着你想保留的曼陀罗，已经有几个在里面。点一个即可打开，也可以添加当前这个。"
          }
        }
      }
    },
