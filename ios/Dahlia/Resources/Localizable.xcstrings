    "menu_daily_widget_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Widget „Mandala des Tages“ für den Startbildschirm zeigt dieselben Favoriten, wenn es keinen eigenen hat; mit Pro wechselt es jeden Morgen, auch wenn der Tageshintergrund aus ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The home screen widget “Mandala of the day” shows the same favourites unless it has one of its own; with Pro it changes every morning, even while the daily wallpaper is off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget «Mandala del día» muestra los mismos favoritos si no tiene uno propio; con Pro cambia cada mañana, aunque el fondo diario esté desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le widget « Mandala du jour » montre les mêmes favoris s'il n'a pas le sien ; avec Pro il change chaque matin, même si le fond d'écran du jour est désactivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il widget «Mandala del giorno» mostra gli stessi preferiti se non ne ha uno suo; con Pro cambia ogni mattina, anche quando lo sfondo del giorno è spento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面のウィジェット「今日のマンダラ」も、専用のお気に入りを選んでいなければ同じお気に入りを表示します。Pro なら毎日の壁紙がオフでも毎朝替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면 위젯 ‘오늘의 만다라’도 따로 고른 즐겨찾기가 없으면 같은 즐겨찾기를 보여 줍니다. Pro는 매일 배경화면이 꺼져 있어도 매일 아침 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O widget “Mandala do dia” mostra os mesmos favoritos se não tiver um próprio; com Pro ele muda toda manhã, mesmo com o papel de parede diário desligado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджет «Мандала дня» показывает то же избранное, если у него нет своей мандалы; с Pro он меняется каждое утро, даже если ежедневные обои выключены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主屏幕小组件“今日曼陀罗”在没有单独选择收藏时显示同样的收藏；有 Pro 时即使每日壁纸关闭，它也会每天早上更换。"
          }
        }
      }
    },
