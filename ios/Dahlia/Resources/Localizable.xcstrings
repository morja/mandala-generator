    "tour_layers_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Mandala besteht aus Ebenen, jede mit ihrem eigenen Stil. Hier fügst du eine hinzu; die kostenlose App erlaubt %1$lld Ebenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mandala is made of layers, each with its own style. The free app allows %1$lld; add one here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mandala se compone de capas, cada una con su propio estilo. Añade una aquí; la app gratuita permite %1$lld capas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mandala se compose de calques, chacun avec son propre style. Ajoutez-en un ici ; l'app gratuite en permet %1$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mandala è fatto di livelli, ognuno con il suo stile. Aggiungine uno qui; l'app gratuita ne consente %1$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曼荼羅はレイヤーでできていて、それぞれに独自のスタイルがあります。ここで追加でき、無料版では%1$lld枚まで使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만다라는 레이어로 이루어지며, 레이어마다 스타일이 있습니다. 여기서 추가할 수 있고, 무료 앱에서는 %1$lld개까지 쓸 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma mandala é feita de camadas, cada uma com seu próprio estilo. Adicione uma aqui; o app gratuito permite %1$lld camadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мандала состоит из слоёв, у каждого свой стиль. Добавьте слой здесь; в бесплатном приложении доступно %1$lld слоя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曼陀罗由图层组成，每个图层都有自己的风格。在这里添加图层；免费版最多可用%1$lld个图层。"
          }
        }
      }
    },
