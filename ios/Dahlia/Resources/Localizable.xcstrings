    "live_layered_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ebenen drehen sich gegeneinander; Hintergrund, Emblem, Text und Zeichnung bleiben stehen. Die Szene-Effekte fallen dabei weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The layers turn against each other; background, emblem, text and drawing stay still. Scene effects are left out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capas giran unas contra otras; el fondo, el emblema, el texto y el dibujo se quedan quietos. Los efectos de escena se omiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calques tournent les uns contre les autres ; le fond, l'emblème, le texte et le dessin restent immobiles. Les effets de scène sont omis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli ruotano l'uno contro l'altro; sfondo, emblema, testo e disegno restano fermi. Gli effetti di scena vengono tralasciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイヤーが互いに逆向きに回り、背景・エンブレム・テキスト・手描きは止まったままです。シーン効果は使われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레이어가 서로 반대로 돌고, 배경·엠블럼·글·그림은 그대로 있습니다. 장면 효과는 빠집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As camadas giram umas contra as outras; fundo, emblema, texto e desenho ficam parados. Os efeitos de cena ficam de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слои вращаются навстречу друг другу; фон, эмблема, текст и рисунок остаются на месте. Эффекты сцены не применяются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各图层相互反向旋转；背景、徽章、文字和手绘保持不动。场景效果不会应用。"
          }
        }
      }
    },
