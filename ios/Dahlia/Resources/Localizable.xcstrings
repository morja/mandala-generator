    "about_privacy_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Werbung, kein Tracking. Deine Mandalas und Einstellungen bleiben auf deinem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No account, no ads, no tracking. Your mandalas and settings stay on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin anuncios, sin seguimiento. Tus mandalas y ajustes se quedan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de publicité, pas de suivi. Vos mandalas et vos réglages restent sur votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessuna pubblicità, nessun tracciamento. I tuoi mandala e le impostazioni restano sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント不要、広告なし、トラッキングなし。マンダラと設定はお使いのデバイス内にのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정, 광고, 추적이 없습니다. 만다라와 설정은 기기에만 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem anúncios, sem rastreamento. Suas mandalas e configurações ficam no seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без аккаунта, без рекламы, без отслеживания. Ваши мандалы и настройки остаются на вашем устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需帐号，没有广告，没有跟踪。你的曼陀罗和设置都保存在你的设备上。"
          }
        }
      }
    },
