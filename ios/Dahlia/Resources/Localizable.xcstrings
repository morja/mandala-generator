    "tour_colours_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Palette färbt die Ebene. Öffne diese Zeile, um eine andere zu probieren oder eine eigene anzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palette colours the layer. Open this row to try another one or to make your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una paleta colorea la capa. Abre esta fila para probar otra o crear la tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une palette colore le calque. Ouvrez cette ligne pour en essayer une autre ou créer la vôtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tavolozza colora il livello. Apri questa riga per provarne un'altra o crearne una tua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パレットがレイヤーに色をつけます。この行を開いて別のパレットを試したり、自分のパレットを作ったりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팔레트가 레이어에 색을 입힙니다. 이 줄을 열어 다른 팔레트를 써 보거나 나만의 팔레트를 만드세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma paleta colore a camada. Abra esta linha para experimentar outra ou criar a sua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Палитра раскрашивает слой. Откройте эту строку, чтобы попробовать другую палитру или создать свою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调色板为图层上色。打开这一行，试试别的调色板，或创建你自己的。"
