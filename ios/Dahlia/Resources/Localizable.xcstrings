    "menu_widgets_about" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Widget hat sein eigenes Mandala und seine eigenen Farben. Auch ein langer Druck auf ein Widget öffnet seine Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each widget has its own mandala and colours. A long press on a widget opens its settings too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada widget tiene su propio mandala y sus colores. Al mantener pulsado un widget también se abren sus ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque widget a son propre mandala et ses couleurs. Un appui long sur un widget ouvre aussi ses réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni widget ha il suo mandala e i suoi colori. Anche una pressione prolungata sul widget apre le sue impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットごとにマンダラと色を選べます。ウィジェットを長押ししても設定を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯마다 만다라와 색을 따로 정할 수 있습니다. 위젯을 길게 눌러도 설정이 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada widget tem sua própria mandala e suas cores. Tocar e segurar um widget também abre os ajustes dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого виджета своя мандала и свои цвета. Настройки также открываются долгим нажатием на виджет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个小组件都有自己的曼陀罗和颜色。长按小组件也能打开它的设置。"
          }
        }
      }
    },
