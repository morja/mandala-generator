    "menu_fast_preview_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Vorschau im Editor wird einfacher und schneller gezeichnet. Gespeicherte Bilder und Hintergründe behalten die volle Qualität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the preview in the editor is drawn simpler and faster. Saved images and wallpapers keep the full quality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la vista previa del editor se dibuja de forma más simple y rápida. Las imágenes guardadas y los fondos conservan toda la calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l'aperçu de l'éditeur est dessiné plus simplement et plus vite. Les images enregistrées et les fonds d'écran gardent toute leur qualité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l'anteprima nell'editor viene disegnata in modo più semplice e veloce. Le immagini salvate e gli sfondi mantengono la piena qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタのプレビューだけを簡略化して速く描画します。保存する画像と壁紙は常にフル品質です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기의 미리보기만 더 간단하고 빠르게 그립니다. 저장한 이미지와 배경화면은 항상 전체 품질입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só a prévia do editor é desenhada de forma mais simples e rápida. Imagens salvas e papéis de parede mantêm a qualidade total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Упрощённо и быстрее рисуется только предпросмотр в редакторе. Сохранённые изображения и обои всегда в полном качестве."
          }
