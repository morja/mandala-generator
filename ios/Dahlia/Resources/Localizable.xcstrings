    "menu_widgets_empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Hinzufügen eine freie Stelle auf dem Startbildschirm lange drücken, „Widgets“ wählen, dann Dahlia."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To add one, touch and hold an empty spot on the home screen, choose Widgets, then Dahlia."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para añadir uno, mantén pulsado un espacio vacío de la pantalla de inicio, elige Widgets y luego Dahlia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour en ajouter un, appuyez longuement sur un espace libre de l'écran d'accueil, choisissez Widgets, puis Dahlia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungerne uno, tieni premuto uno spazio vuoto della schermata Home, scegli Widget, poi Dahlia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加するには、ホーム画面の空いている所を長押しし、「ウィジェット」から Dahlia を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가하려면 홈 화면의 빈 곳을 길게 누르고 위젯을 고른 뒤 Dahlia를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para adicionar, toque e segure um espaço vazio da tela inicial, escolha Widgets e depois Dahlia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы добавить, нажмите и удерживайте пустое место на главном экране, выберите «Виджеты», затем Dahlia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要添加，请长按主屏幕空白处，选择“小组件”，然后选择 Dahlia。"
          }
        }
      }
