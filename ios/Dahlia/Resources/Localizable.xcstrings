    "tour_play_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kompass öffnet die Spielfläche. Zieh einen Finger darüber, und das Mandala verändert sich mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The compass opens the play field. Drag a finger across it and the mandala changes as you go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La brújula abre el campo de juego. Desliza un dedo por él y el mandala cambia contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La boussole ouvre le terrain de jeu. Faites glisser un doigt dessus et le mandala change au fil du geste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bussola apre il campo di gioco. Trascina un dito sopra e il mandala cambia mentre ti muovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパスでプレイフィールドが開きます。指でなぞると、それに合わせて曼荼羅が変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나침반을 누르면 놀이판이 열립니다. 손가락으로 끌면 그에 따라 만다라가 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bússola abre o campo de jogo. Deslize um dedo por ele e a mandala muda junto com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компас открывает игровое поле. Проведите по нему пальцем, и мандала будет меняться вслед за ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指南针会打开游戏场。用手指在上面划动，曼陀罗会随之变化。"
          }
        }
      }
    },
