    "controls_background_auto_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein dunkles Leuchten und feine Fasern in den Farben der untersten Ebene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dark glow and fine fibres in the colours of the bottom layer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un resplandor oscuro y fibras finas en los colores de la capa inferior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une lueur sombre et de fines fibres aux couleurs du calque du bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bagliore scuro e fibre sottili nei colori del livello più in basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一番下のレイヤーの色で、暗い光と細かな繊維を描きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맨 아래 레이어의 색으로 어두운 빛과 가는 섬유 무늬를 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um brilho escuro e fibras finas nas cores da camada inferior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тёмное свечение и тонкие волокна в цветах нижнего слоя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深色光晕和细纤维，采用底层图层的颜色。"
          }
        }
      }
    },
