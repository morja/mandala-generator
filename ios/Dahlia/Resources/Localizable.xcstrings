    "tour_die_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo du diesen Würfel siehst, würfelt er etwas Neues aus, und mehr Punkte ändern mehr. Der Pfeil oben links bringt dich zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wherever you see this die, it rolls something new at random, and more dots change more. The arrow at the top left takes you back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donde veas este dado, crea algo nuevo al azar, y cuantos más puntos, más cambia. La flecha de arriba a la izquierda te devuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partout où vous voyez ce dé, il tire quelque chose de nouveau au hasard, et plus il a de points, plus il change. La flèche en haut à gauche vous ramène en arrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove vedi questo dado, crea qualcosa di nuovo a caso, e più puntini ha, più cambia. La freccia in alto a sinistra ti riporta indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイコロがある場所では、ランダムに新しいものが生まれ、点が多いほど大きく変わります。左上の矢印で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주사위가 보이는 곳에서는 무작위로 새로운 것이 만들어지고, 점이 많을수록 더 많이 바뀝니다. 왼쪽 위 화살표로 되돌릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onde você vir este dado, ele cria algo novo ao acaso, e quanto mais pontos, mais muda. A seta no canto superior esquerdo desfaz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Где бы вы ни увидели этот кубик, он случайно создаёт что-то новое, и чем больше точек, тем больше перемен. Стрелка слева вверху возвращает назад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凡是看到这个骰子的地方，它都会随机生成新内容，点数越多，变化越大。左上角的箭头可以撤回。"
          }
        }
      }
    },
