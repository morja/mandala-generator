      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Emblem gibt es mit Pro. Ausprobieren und als Favorit behalten geht auch ohne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The emblem comes with Pro. You can try it and keep it as a favourite without Pro."
