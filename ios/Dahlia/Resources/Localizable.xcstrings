        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O favorito do dia na sua tela inicial. Quadrado mostra a imagem; largo acrescenta as palavras. Com Pro, um novo a cada manhã."
          }
        },
        "ru" : {
          "stringUnit" : {
