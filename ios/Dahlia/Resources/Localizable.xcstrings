    "live_daily_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit aktivem täglichem Hintergrund blendet der Live-Hintergrund jeden Morgen zum nächsten Favoriten über."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the daily wallpaper on, the live wallpaper fades over to the next favourite every morning."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el fondo diario activado, el fondo animado pasa cada mañana al siguiente favorito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le fond d'écran quotidien activé, le fond d'écran animé passe en fondu au favori suivant chaque matin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con lo sfondo del giorno attivo, ogni mattina lo sfondo animato sfuma nel preferito successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日替わり壁紙がオンのときは、毎朝ライブ壁紙が次のお気に入りへ切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 배경화면을 켜 두면 라이브 배경화면이 매일 아침 다음 즐겨찾기로 서서히 바뀝니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o plano de fundo diário ativado, o plano de fundo animado passa suavemente para o próximo favorito toda manhã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включены ежедневные обои, живые обои каждое утро плавно переходят к следующей мандале из избранного."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启每日壁纸后，动态壁纸每天早上会渐变到下一个收藏。"
          }
        }
      }
    },
    "live_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Mandala füllt den Bildschirm und dreht sich langsam, eine Umdrehung in vier Minuten. Es bewegt sich nur, während du es siehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mandala fills the screen and turns slowly, one turn in four minutes. It only moves while you see it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mandala llena la pantalla y gira despacio, una vuelta cada cuatro minutos. Solo se mueve mientras lo ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mandala remplit l'écran et tourne lentement, un tour en quatre minutes. Il ne bouge que lorsque vous le voyez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo mandala riempie lo schermo e gira lentamente, un giro ogni quattro minuti. Si muove solo quando lo vedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマンダラが画面いっぱいに広がり、4分で1回転のペースでゆっくり回ります。動くのは画面が見えているときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 만다라가 화면을 가득 채우고 4분에 한 바퀴씩 천천히 돌아갑니다. 화면이 보일 때만 움직입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta mandala preenche a tela e gira devagar, uma volta a cada quatro minutos. Ela só se move enquanto você a vê."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта мандала заполняет экран и медленно вращается: один оборот за четыре минуты. Она движется, только когда вы её видите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此曼陀罗铺满屏幕并缓缓旋转，四分钟转一圈。只有在你看得见时才会转动。"
          }
        }
      }
    },
