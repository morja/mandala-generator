    "menu_daily_about" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer einer deiner Favoriten, jeden Morgen der nächste.\nAuf dem Sperrbildschirm, auf dem Startbildschirm etwas dunkler.\nZwischen 4 und 8 Uhr, am liebsten beim Laden; der erste gleich beim Einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of your favourites at a time, the next one every morning.\nOn the lock screen, and a little darker on the home screen.\nBetween 4 and 8 o'clock, preferably while the phone charges; the first one as soon as you switch it on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno de tus favoritos cada vez, el siguiente cada mañana.\nEn la pantalla de bloqueo y, algo más oscuro, en la de inicio.\nEntre las 4 y las 8, mejor mientras se carga el teléfono; el primero en cuanto lo activas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un de vos favoris à la fois, le suivant chaque matin.\nSur l'écran de verrouillage et, un peu plus sombre, sur l'écran d'accueil.\nEntre 4 et 8 heures, de préférence pendant la charge ; le premier dès l'activation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno dei tuoi preferiti alla volta, il successivo ogni mattina.\nSulla schermata di blocco e, un po' più scuro, sulla schermata Home.\nTra le 4 e le 8, meglio mentre il telefono è in carica; il primo appena lo attivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りを1枚ずつ、毎朝次の1枚へ。\nロック画面に、ホーム画面には少し暗くして。\n4時から8時のあいだ、できれば充電中に。最初の1枚はオンにした時点で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기 중 하나씩, 매일 아침 다음 것으로.\n잠금 화면에, 홈 화면에는 조금 더 어둡게.\n4시에서 8시 사이, 가능하면 충전 중에. 첫 번째는 켜는 즉시."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dos seus favoritos de cada vez, o próximo toda manhã.\nNa tela de bloqueio e, um pouco mais escuro, na tela inicial.\nEntre 4 e 8 horas, de preferência enquanto carrega; o primeiro assim que você ativar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному из ваших избранных, каждое утро следующий.\nНа экране блокировки и, чуть темнее, на главном экране.\nМежду 4 и 8 часами, лучше во время зарядки; первый сразу после включения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次一张你的收藏，每天早上换下一张。\n设为锁屏，并以稍暗的效果设为主屏幕。\n在 4 点到 8 点之间，最好在充电时；开启后立即换上第一张。"
          }
        }
      }
    },
