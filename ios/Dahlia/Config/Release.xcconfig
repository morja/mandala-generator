// Release: the final bundle id (PLAN-4 F1, approval A1) and the plain icon.
#include? "Signing.xcconfig"
DAHLIA_BUNDLE_ID = one.tearoom.mandala
PRODUCT_BUNDLE_IDENTIFIER = $(DAHLIA_BUNDLE_ID)
DAHLIA_DISPLAY_NAME = Dahlia
DAHLIA_APP_ICON = AppIcon
// The App Group (approval A2) shared with the widget, and the widget tap's URL scheme.
DAHLIA_APP_GROUP = group.one.tearoom.mandala
DAHLIA_URL_SCHEME = dahlia
