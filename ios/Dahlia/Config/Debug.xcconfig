// Debug: its own bundle id, name and marked icon, so it sits next to the store app (global rule for local builds).
#include? "Signing.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = one.tearoom.mandala.debug
DAHLIA_DISPLAY_NAME = Dahlia Debug
DAHLIA_APP_ICON = AppIconDebug
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
