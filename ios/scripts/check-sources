#!/usr/bin/env python3
"""Source rules of the iPhone app (PLAN-4 sections 3.9 and 3.10), like Android's ArchitectureTest.

In the screens (ios/Dahlia/Sources/UI and App) and, for colours, fonts and texts, everything else except the generated Theme/Tokens.swift:
- no colour literals (Color(...), UIColor(...), named colours such as .white);
- no fonts other than the text roles (no .font(...)); no font sizes;
- no number literals in layout calls (frame, padding, spacing, cornerRadius, lineWidth, offset, opacity, ...);
  a literal after * or / (a share of a width) and 0 are fine, every other size is a token;
- no readable English in Text, Button, Label or accessibilityLabel: texts come from Texts (the catalogue);
- every key in Texts.swift exists in the generated catalogue.
A line may carry `// token-exempt: <reason>` for a colour that comes from the mandala itself, not from the UI.
"""
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SOURCES = ROOT / "ios/Dahlia/Sources"
CATALOGUE = ROOT / "ios/Dahlia/Resources/Localizable.xcstrings"

COLOUR = re.compile(r"\b(?:Color|UIColor|CGColor)\(|\.(?:white|black|red|green|blue|orange|yellow|gray|grey|purple|pink|brown|cyan|mint|teal|indigo|primary|secondary)\b(?!\()")
FONT = re.compile(r"\.font\(|\bFont\.|UIFont|\.system\(size")
LAYOUT = re.compile(r"\.(?:frame|padding|offset|opacity|cornerRadius|shadow|blur|scaleEffect)\(|\b(?:spacing|lineWidth|cornerRadius|minimum|maximum|radius|size|width|height|opacity):")
NUMBER = re.compile(r"(?<![\w.$])(\d+(?:\.\d+)?)\b")
TEXT = re.compile(r'\b(?:Text|Button|Label|accessibilityLabel|navigationTitle|Section|TextField)\("((?:[^"\\]|\\.)*)"')


def strip_interpolation(s):
    """Removes every \\( ... ) with nested brackets."""
    out, depth, i = [], 0, 0
    while i < len(s):
        if depth == 0 and s.startswith("\\(", i):
            depth, i = 1, i + 2
            continue
        if depth:
            depth += {"(": 1, ")": -1}.get(s[i], 0)
        else:
            out.append(s[i])
        i += 1
    return "".join(out)


def check_file(path, layout):
    problems = []
    for n, raw in enumerate(path.read_text().splitlines(), 1):
        code = raw.split("//")[0] if "token-exempt" not in raw else ""
        if not code.strip():
            continue
        where = f"{path.relative_to(ROOT)}:{n}"
        no_strings = re.sub(r'"(?:[^"\\]|\\.)*"', '""', code)
        if COLOUR.search(no_strings):
            problems.append(f"{where}: colour literal; use a token (Tokens.swift)")
        if FONT.search(no_strings):
            problems.append(f"{where}: font outside the text roles; use .textRole(...)")
        if layout and LAYOUT.search(no_strings):
            rest = re.sub(r"[*/]\s*\d+(?:\.\d+)?", "", no_strings)
            for m in NUMBER.finditer(rest):
                if float(m.group(1)) != 0:
                    problems.append(f"{where}: number literal {m.group(1)} in a layout call; use a token")
                    break
        for m in TEXT.finditer(code):
            if re.search(r"[A-Za-z]{2}", strip_interpolation(m.group(1))):
                problems.append(f"{where}: literal text \"{m.group(1)}\"; use Texts (the catalogue)")
    return problems


def check_keys():
    catalogue = json.loads(CATALOGUE.read_text())["strings"]
    src = (SOURCES / "Model/Texts.swift").read_text()
    keys = set(re.findall(r'\b(?:text|format)\("([a-z0-9_]+)"', src))
    return [f"ios/Dahlia/Sources/Model/Texts.swift: key {k} is not in the catalogue" for k in sorted(keys - set(catalogue))]


problems = []
for f in sorted(SOURCES.rglob("*.swift")):
    if f.name == "Tokens.swift" and f.parent.name == "Theme":
        continue
    problems += check_file(f, layout=f.parent.name in ("UI", "App"))
problems += check_keys()
if problems:
    print("\n".join(problems), file=sys.stderr)
    sys.exit(1)
