#!/usr/bin/env python3
"""Generates ios/Dahlia/Sources/Theme/Tokens.swift from Android's Tokens.kt (PLAN-4 section 3.10).

Taken from Tokens.kt: the Spacing, Radius and Sizes objects (dp become points one to one) and the
colours of DarkTokens and LightTokens. The text roles on Dynamic Type (approval A9) exist only on iOS and
live in the template below.

  ios/scripts/gen-tokens            write Tokens.swift
  ios/scripts/gen-tokens --check    exit 1 when Tokens.swift is out of date
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
SOURCE = ROOT / "android/app/src/main/kotlin/com/mathis/mandala/app/ui/theme/Tokens.kt"
OUT = ROOT / "ios/Dahlia/Sources/Theme/Tokens.swift"


def numbers(src, obj):
    """The `val name = N.dp` lines of `object obj`, with the one-line doc comment above each."""
    body = re.search(r"object %s \{(.*?)\n\}" % obj, src, re.S).group(1)
    out, doc = [], None
    for line in body.splitlines():
        line = line.strip()
        m = re.match(r"/\*\*\s*(.*?)\s*\*/$", line)
        if m:
            doc = m.group(1)
            continue
        m = re.match(r"val (\w+) = ([\d.]+)\.dp$", line)
        if m:
            out.append((m.group(1), m.group(2).rstrip("0").rstrip(".") if "." in m.group(2) else m.group(2), doc))
            doc = None
    return out


def colours(src, name):
    body = re.search(r"val %s = Tokens\((.*?)\n\)" % name, src, re.S).group(1)
    return re.findall(r"(\w+) = Color\(0xFF([0-9A-Fa-f]{6})\)", body)


def fields(src):
    body = re.search(r"data class Tokens\((.*?)\n\)", src, re.S).group(1)
    out, doc = [], None
    for line in body.splitlines():
        line = line.strip()
        m = re.match(r"/\*\*\s*(.*?)\s*\*/$", line)
        if m:
            doc = m.group(1)
            continue
        m = re.match(r"val (\w+): Color,$", line)
        if m:
            out.append((m.group(1), doc))
            doc = None
    return out


def build():
    src = SOURCE.read_text()
    out = ["""import SwiftUI

// GENERATED by ios/scripts/gen-tokens from android/app/.../ui/theme/Tokens.kt; do not edit (the check fails on
// a stale file). The only place for colours, spacing, radii, sizes and text roles in the iPhone app
// (PLAN-4 section 3.10); screens use only these names. dp become points one to one.
"""]
    for obj in ("Spacing", "Radius", "Sizes"):
        out.append(f"enum {obj} {{")
        for i, (name, value, doc) in enumerate(numbers(src, obj)):
            if doc:
                out.append(("\n" if i else "") + f"    /// {doc}")
            out.append(f"    static let {name}: CGFloat = {value}")
        out.append("}\n")
    names = fields(src)
    dark, light = dict(colours(src, "DarkTokens")), dict(colours(src, "LightTokens"))
    assert [n for n, _ in names] == list(dark) == list(light), "Tokens.kt: fields and colour sets differ"
    out.append("/// One set of semantic colours; light and dark differ only here (ADR-0006).\nstruct Tokens: Sendable {")
    for n, doc in names:
        out.append((f"    /// {doc}\n" if doc else "") + f"    let {n}: Color")
    out.append("""
    /// The other theme's accent, for the action on an inverted message (Android's `inversePrimary`).
    var inverseAccent: Color { self.accent == Tokens.dark.accent ? Tokens.light.accent : Tokens.dark.accent }
""")
    for label, colour in (("dark", dark), ("light", light)):
        out.append(f"    static let {label} = Tokens(")
        out.append(",\n".join(f"        {n}: Color(hex: 0x{v.upper()})" for n, v in colour.items()))
        out.append("    )\n" if label == "dark" else "    )")
    out.append("}\n")
    out.append("""/// Text roles on Dynamic Type (approval A9): six roles on the system text styles (SF Pro), so large system
/// text works. Sizes at the default setting; the roles of one size differ by weight or digits, neighbouring
/// sizes by at least 1.2 (28, 20, 15, 12). The mapping from Android's type scale is in docs/IOS-3-strings-and-tokens.md.
enum TextRole {
    /// Large screen titles; no screen uses it yet.
    case display
    /// Sheet titles (Android titleMedium).
    case title
    /// Group headings, tabs and buttons (Android titleSmall): the body size, heavier.
    case heading
    /// Labels and rows (Android bodyMedium).
    case body
    /// Summaries and hints, shown muted (Android bodySmall).
    case note
    /// Numbers beside controls: the note size with tabular digits.
    case value

    var font: Font {
        switch self {
        case .display: .title
        case .title: .title3.weight(.semibold)
        case .heading: .subheadline.weight(.semibold)
        case .body: .subheadline
        case .note: .caption
        case .value: .caption.monospacedDigit()
        }
    }
}

extension Color {
    /// sRGB from 0xRRGGBB; used only in this file.
    fileprivate init(hex: UInt32) {
        self.init(.sRGB, red: Double((hex >> 16) & 0xFF) / 255, green: Double((hex >> 8) & 0xFF) / 255, blue: Double(hex & 0xFF) / 255)
    }
}

private struct TokensKey: EnvironmentKey {
    static let defaultValue = Tokens.dark
}

extension EnvironmentValues {
    var tokens: Tokens {
        get { self[TokensKey.self] }
        set { self[TokensKey.self] = newValue }
    }
}

extension View {
    func textRole(_ role: TextRole) -> some View { font(role.font) }
}""")
    return "\n".join(out) + "\n"


text = build()
if "--check" in sys.argv:
    if not OUT.exists() or OUT.read_text() != text:
        print("ios/Dahlia/Sources/Theme/Tokens.swift is out of date: run ios/scripts/gen-tokens", file=sys.stderr)
        sys.exit(1)
else:
    OUT.write_text(text)
    print("Tokens.swift written")
