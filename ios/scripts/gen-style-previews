#!/bin/sh
# Copies Android's small example pictures beside each style and each emblem motif into the iPhone app's
# resources, so both apps show the same ones (PLAN-4 section 2, "Styles" and "Emblem"). Android's files
# are the source.
#
#   ios/scripts/gen-style-previews           copy them
#   ios/scripts/gen-style-previews --check   exit 1 when the copies are out of date
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
from="$here/../android/app/src/main/res/drawable-nodpi"
to="$here/Dahlia/Resources/StylePreviews"
patterns="style_preview_ emblem_preview_"
if [ "${1:-}" = "--check" ]; then
    for p in $patterns; do
        for f in "$from"/"$p"*.png; do
            cmp -s "$f" "$to/$(basename "$f")" || { echo "style or emblem pictures are out of date: run ios/scripts/gen-style-previews" >&2; exit 1; }
        done
        for f in "$to"/"$p"*.png; do
            [ -f "$from/$(basename "$f")" ] || { echo "picture without Android original: $f" >&2; exit 1; }
        done
    done
    exit 0
fi
mkdir -p "$to"
for p in $patterns; do
    rm -f "$to"/"$p"*.png
    cp "$from"/"$p"*.png "$to/"
done
