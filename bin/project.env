# Values for the shared android commands in ~/Work/Cockpit/bin/android (see project.env.example there).
APP_SLUG=mandala-generator
APP_ID=one.tearoom.mandala
GRADLE_DIR=android
APP_MODULE=app
INSTALL_BUILD_TYPE=fast
DEBUG_ID_SUFFIX=.debug
CHECK_TASKS=":core:test :core:memoryTest :editing:test :cli:compileTestKotlin :cli:installDist :app:testDebugUnitTest"
# CHECK_FULL_CMD replaces the task list: the script runs the full check for both platforms.
CHECK_FULL_CMD="android/scripts/check-full"
METADATA_DIR=store/android
# The widget sheet (bin/widget-sheet, Cockpit docs/android-widget-sheet.md): both layouts in every launcher box.
WIDGET_SHEET_ACTIVITY=com.mathis.mandala.app.sheet.WidgetSheetActivity
WIDGET_SHEET_DEFAULT="texts=100,145 locales=de,ru looks=LIGHT,DARK"
WIDGET_SHEET_FULL="texts=90,100,115,130,145 locales=de,en,ru,ja looks=LIGHT,DARK"
