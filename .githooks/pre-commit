#!/bin/sh
# Runs the check of each platform whose files are staged; docs-only commits need none.
set -eu
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -q '^android/'; then
    bin/check
fi
if printf '%s\n' "$staged" | grep -q '^mac/'; then
    swift build --package-path mac
fi
# The iPhone app, and the core and editing rules it links (the release framework is rebuilt, cached by Gradle).
if printf '%s\n' "$staged" | grep -qE '^(ios/|android/core/|android/editing/)'; then
    ios/scripts/check
fi
# Android's texts and tokens feed the iPhone app's generated catalogue and Tokens.swift (cheap staleness check).
if printf '%s\n' "$staged" | grep -qE '^android/app/src/main/res/values.*/strings|^android/app/src/main/kotlin/.*/ui/theme/Tokens\.kt'; then
    ios/scripts/gen-strings --check
    ios/scripts/gen-tokens --check
fi
