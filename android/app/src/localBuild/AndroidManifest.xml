<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- The rating prompt for testing (kit ADR-0006), local builds only:
             adb shell am broadcast -n one.tearoom.mandala.fast/one.tearoom.review.ReviewDebugReceiver -a one.tearoom.review.FORCE
             (also .RESET and .STATUS; the status line comes back as the broadcast's data). -->
        <receiver
            android:name="one.tearoom.review.ReviewDebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />
        <!-- The widget sheet for bin/widget-sheet (Cockpit docs/android-widget-sheet.md), started through adb:
             it draws the home screen widget in every launcher size and writes the pictures. -->
        <activity
            android:name="com.mathis.mandala.app.sheet.WidgetSheetActivity"
            android:exported="true"
            tools:ignore="ExportedActivity" />
    </application>
</manifest>
