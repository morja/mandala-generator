<?xml version="1.0" encoding="utf-8"?>
<!-- Local builds only: the launcher art plus a small mark bottom right, so the locally installed app can
     be told from the Play build without its name. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@mipmap/ic_launcher_art" />
    <item>
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <!-- Inside the 66 dp safe zone: centre (73,73), a dark ring so it stands out on the art. -->
            <path android:fillColor="#151413" android:pathData="M65,73a8,8 0 1,0 16,0a8,8 0 1,0 -16,0z" />
            <path android:fillColor="#E2A85E" android:pathData="M67.5,73a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0z" />
        </vector>
    </item>
</layer-list>
