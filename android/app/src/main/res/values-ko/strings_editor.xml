    <!-- Editor: Pro sheet -->
    <string name="editor_pro_title">Dahlia Pro</string>
    <string name="editor_pro_uses_keep">이 만다라는 Pro 기능을 사용합니다. 지금 모습 그대로 간직하려면 Pro를 구매하세요:</string>
