    <!-- Editor: Pro sheet -->
    <string name="editor_pro_title">Dahlia Pro</string>
    <string name="editor_pro_uses_keep">Эта мандала использует функции Pro. Чтобы сохранить её, поделиться ею или поставить на обои в таком виде, оформите Pro:</string>
