    <!-- Editor: Pro sheet -->
    <string name="editor_pro_title">Dahlia Pro</string>
    <string name="editor_pro_uses_keep">Dieses Mandala nutzt, was es mit Pro gibt. Um es so zu speichern, zu teilen oder als Hintergrund zu setzen, hol dir Pro:</string>
