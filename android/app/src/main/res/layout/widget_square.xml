<?xml version="1.0" encoding="utf-8"?>
<!-- Mandala of the day, square sizes (ADR-0020): the picture alone, clipped to the widget's corners. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_label"
        android:scaleType="centerCrop" />

    <!-- Local builds only: the launcher icon's mark (WidgetMark), so the local build's widget is told apart. -->
    <ImageView
        android:id="@+id/widget_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/widget_gap"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mark"
        android:visibility="gone" />
</FrameLayout>
